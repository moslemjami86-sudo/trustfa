# کپی کنید به .env و مقادیر را پر کنید

# دیتابیس — روی Railway/Render معمولاً خودشان DATABASE_URL می‌دهند
DATABASE_URL=postgresql+psycopg2://trustfa:trustfa@localhost:5432/trustfa

# کلید امنیتی JWT (یک رشته تصادفی بلند)
SECRET_KEY=change-this-to-a-long-random-string

# Google OAuth — از Google Cloud Console
# APIs & Services → Credentials → Create OAuth client ID → Web application
# Authorized JavaScript origins: https://YOUR-DOMAIN
# Authorized redirect URIs: https://YOUR-DOMAIN (برای GIS معمولاً origin کافی است)
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# ایمیل‌هایی که ادمین می‌شوند (با کاما)
ADMIN_EMAILS=you@gmail.com,admin@example.com

# CORS (دامنه فرانت اگر جدا باشد)
CORS_ORIGINS=*
